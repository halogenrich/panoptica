{
  "name": "perovskite-lab",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @psc/server",
    "dev:web": "npm run dev -w @psc/web",
    "build": "npm run build -w @psc/web",
    "start": "npm run start -w @psc/server",
    "test": "npm run test -w @psc/core",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/web --noEmit",
    "test:server": "node --no-warnings tools/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:server && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1"
  },
  "version": "0.31.0"
}
